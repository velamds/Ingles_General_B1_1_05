Activity 3", "type": "group_name"}]}, {"content": {"allowed_attempts": 2, "incorrect_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}], "correct_feedback": "You are done!", "attempt_feedback": [{"content": "", "type": "text"}, {"content": "", "type": "text"}]}, "type": "feedback"}, {"type": "learning_skills", "contents": [{"content": "Reading", "type": "skill"}, {"content": "Writing", "type": "skill"}, {"content": "Listening", "type": "skill"}, {"content": "Speaking", "type": "skill"}]}, {"type": "instructions", "contents": [{"content": "Did you read over your customer complaint?<br>", "type": "text"}, {"content": "Remember, customer complaints include:<br>\n<ul><li>A formal greeting</li>\n<li>Phrases to describe a situation</li>\n<li>Phrases to describe a problem</li>\n<li>Phrases to describe a solution</li>\n<li>A formal closing</li></ul>", "type": "text"}, {"content": "Proofread your complaint for any spelling, grammar or punctuation errors.<br/>", "type": "text"}, {"content": "Read your complaint aloud to a partner.<br/><br/>", "type": "text"}, {"content": "Click the <span class=\"strong\">Submit</span> button to save your work.", "type": "text"}]}, {"type": "grading_chart", "grading_contents": {"body": {"rows": [{"cells": [{"content": "", "element": "th", "colspan": 1, "content_type": "text"}, {"content": [" "], "element": "th", "points": "20", "colspan": 1, "content_type": "text"}, {"content": [" "], "element": "th", "points": "20", "colspan": 1, "content_type": "text"}, {"content": [" "], "element": "th", "points": "20", "colspan": 1, "content_type": "text"}, {"content": [" "], "element": "th", "points": "20", "colspan": 1, "content_type": "text"}]}, {"cells": [{"content": "", "element": "th", "colspan": 1, "content_type": "text"}, {"content": [" "], "element": "th", "points": "20", "colspan": 1, "content_type": "text"}, {"content": [" "], "element": "th", "points": "20", "colspan": 1, "content_type": "text"}, {"content": [" "], "e