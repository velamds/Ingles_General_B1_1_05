question"}, {"contents": {"type": "", "content": "our new pasta dish! "}, "type": "post_question"}, {"type": "objective", "content": "secondary_8"}]}], "type": "TYP", "id": 10, "_data": [{"contents": [{"type": "text", "content": " \nSusan talks about the new menu."}], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "text", "content": "Instructions: Listen to the audio. Type in the missing words."}], "type": "post_instructions"}]}, {"stimuli_ids": [], "template_override": 1, "questions": [{"responses": [{"correct": 0, "id": 0, "selected": 0, "_data": [{"type": "text", "content": ""}]}, {"correct": 1, "id": 1, "selected": 0, "_data": [{"type": "text", "content": ""}]}], "id": 0, "_data": [{"contents": [{"type": "text", "content": ""}], "type": "question"}]}], "type": "RSLT", "id": 11, "_data": [{"contents": [], "type": "instructions"}, {"contents": [{"type": "group_name", "content": "Quiz"}], "type": "group"}, {"type": "feedback", "content": {"allowed_attempts": 2, "correct_feedback": "Correct!", "attempt_feedback": [{"type": "text", "content": ""}, {"type": "text", "content": ""}], "incorrect_feedback": [{"type": "text", "content": "Whoops! Something important is missing."}, {"type": "text", "content": "Maybe next time..."}]}}, {"contents": [{"type": "skill", "content": "Reading"}, {"type": "skill", "content": "Writing"}, {"type": "skill", "content": "Speaking"}], "type": "learning_skills"}]}], "type": "scholar", "stimuli": [{"type": "welcome", "contents": [{}], "template_override": 1, "id": 0, "_data": []}, {"contents": [{"type": "slideshow", "value": {"coverimg": "engenn6le05ob02re2img06.jpg", "audiosrc": "engenn6le05ob02re2aud01", "images": [{"time": "0", "image": "engenn6le05ob02re2img06.jpg", "id": 0, "text": ""}, {"time": "0", "image": "engenn6le05ob02re2img06.jpg", "id": 1, "text": "<span class=\"strong\">Vanessa</span>: Good afternoon, sir. What seems to be the problem here?<br>\n<span class=\"strong\">Steve</span>: I was on the phone with a client when your employee asked me to end the conversation! This is a deal breaker!<br>\n<span class=\"strong\">Vanessa</span>: I am sorry to hear that, but she was only doing her job. <br>\n<span class=\"strong\">Steve</span>: She was extremely rude!"}, {"time": "15000", "image": "engenn6le05ob02re2img05.jpg", "id": 2, "text": "<span class=\"strong\">Vanessa</span>: Sir, we take great care in hiring our waiters and floor staff. Sarah was very patient and polite.<br>\n<span class=\"strong\">Steve</span>: This is unacceptable! I am one of your most valued customers! I can take my calls whenever I want to!<br>\n<span class=\"strong\">Vanessa</span>: Sir, you might want  to lower your voice. You are yelling in front of everyone."}, {"time": "35000", "image": "engenn6le05ob02re2img05.jpg", "id": 3, "text": "<span class=\"strong\">Steve</span>: So what? Do you know who I am? <br>\n<span class=\"strong\">Vanessa</span>: I am sure you're a very busy person, but you ought to calm down. You should continue enjoying your meal. May I offer you a complimentary dessert? <br>\n<span class=\"strong\">Steve</span>: You'd better know who you're talking to! I can shut this place down if I want to. <br>\n<span class=\"strong\">Vanessa</span>: Sir, I'm going to have to ask you to leave."}]}}], "template_override": 1, "title": "", "type": "audio", "id": 1, "_data": []}], "id": 0, "_data": [{"contents": [{"type": "has_nav", "content": true}, {"type": "has_exercise_controls", "content": true}], "type": "lab_options"}]}], "_data": [{"contents": [{"type": "lesson_name", "content": "Vanessa and The Rude Customer"}, {"type": "unit_name", "content": "Not in My House!"}, {"type": "position", "content": 2}, {"type": "origin", "content": "scholar > Food for Thought > Recipe - Chocolate Chip Cookies"}, {"type": "lesson", "content": 5}, {"type": "level", "content": "B1.1"}], "type": "metadata"}, {"contents": [{"type": "test", "content": "false"}], "type": "achievment_test"}, {"contents": [{"type": "primary", "content": "Accurately use important information about people's jobs and places of work in communicative situations."}, {"type": "secondary_1", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_2", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_3", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_4", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_5", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_6", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_7", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}, {"type": "secondary_8", "content": "Understands important and some specific information and aspects of attitude and intention using a range of appropriate language, in written or spoken documents or presentations"}], "type": "objectives"}, {"type": "background_image", "content": "engenn6le05ob02re1img01.jpg"}, {"contents": [{"type": "heading", "content": "Dealing With Customers"}, {"type": "describer", "content": "When you work in a restaurant or in a shop, it is important to deal with customers properly and show politeness.<br><br>Remember to respond to their requests politely even when you are refusing the requests. Use the modals  <span class=\"italic\">could</span>, <span class=\"italic\">should</span> or <span class=\"italic\">might</span>"}, {"type": "text", "content": "Here is a list of ways to start requests and polite responses:"}, {"type": "table", "content": "{\"rows\":5,\"columns\":3,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Requesting politely\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Refusing  requests \\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"Granting requests\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<ul><li>You might want to ... </li> <li>Would you mind ... ?</li> <li>You should ... </li> <li>You ought to ...  (strong request)</li></ul>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<ul><li>I understand, sir/madam, but ... </li> <li>I'm afraid not</li> <li>I'm sorry, but ... </li></ul>\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\"<ul><li>Of course!</li><li>RIght away.</li><li>I'd be happy to do that for you.</li></ul>\\\"}\"],\"styles\":\" intro_table_border instruction_table_background\"}"}, {"type": "example", "content": "<span class=\"strong\">Customer</span>: Your waiter was rude! He asked me to turn my phone off!  "}, {"type": "example", "content": "<span class=\"strong\">Manager</span>: I'm sorry, but the waiter was doing his job. "}, {"type": "example", "content": "<span class=\"strong\">Customer</span>: You should know who you're talking to!"}], "type": "learning_points"}, {"contents": [{"type": "heading", "content": "Expressing What is Necessary"}, {"type": "describer", "content": " "}, {"type": "text", "content": " You use had better ('d better) to give strong advice, or to tell people what to do. There can be an element of threat: \"if you don't do this, something bad will happen.\"<br><span class=\"italic\">Example:  You'd better know who you're talking to!</span>"}, {"type": "text", "content": "Should and ought to express mild obligation or advice. Should is much more common.<br> <span class=\"italic\">Examples:  I am sure you're a very busy person, but you ought to calm down.<br> You should continue enjoying your meal.</span>"}], "type": "learning_points"}, {"contents": [{"type": "name", "content": "deal breaker "}, {"type": "definition", "content": "a serious issue; a problem  "}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: What do you mean I can't use my phone? This is a deal breaker!"}, {"type": "audio", "content": "engenn6le05ob02aud01"}], "type": "target_word"}, {"contents": [{"type": "text", "content": " These are words you hear in a conversation with a difficult customer."}], "type": "target_word_describer"}, {"contents": [{"type": "name", "content": "extremely "}, {"type": "definition", "content": "to a great degree "}, {"type": "part_speech", "content": "(adverb):"}, {"type": "example", "content": "Example: The customer was extremely rude."}, {"type": "audio", "content": "engenn6le05ob02aud02"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "floor staff "}, {"type": "definition", "content": "employees who works in a restaurant, setting and cleaning tables "}, {"type": "part_speech", "content": "(noun)"}, {"type": "example", "content": "Example: We train our floor staff to deal with difficult customers."}, {"type": "audio", "content": "engenn6le05ob02aud03"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "unacceptable"}, {"type": "definition", "content": "impossible to accept "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: What do you mean I can't use my phone? This is unacceptable."}, {"type": "audio", "content": "engenn6le05ob02aud04"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "valued"}, {"type": "definition", "content": "held in high regard; important "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: I am one of your most valued customers!"}, {"type": "audio", "content": "engenn6le05ob02aud05"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "So what? "}, {"type": "definition", "content": "I don't care!"}, {"type": "part_speech", "content": "(expression)"}, {"type": "example", "content": "Example: <span class=\"strong\"><br/>Ann</span>: You are yelling in front of everyone.<br><span class=\"strong\">Bob</span>: So what?"}, {"type": "audio", "content": "engenn6le05ob02aud06"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "complimentary "}, {"type": "definition", "content": "at no additional cost "}, {"type": "part_speech", "content": "(adjective)"}, {"type": "example", "content": "Example: Please enjoy a complimentary dessert."}, {"type": "audio", "content": "engenn6le05ob02aud07"}], "type": "target_word"}, {"contents": [{"type": "name", "content": "to shut down "}, {"type": "definition", "content": "to cease business or operation"}, {"type": "part_speech", "content": "(verb)"}, {"type": "example", "content": "Example: I can shut down your restaurant if I want to!"}, {"type": "audio", "content": "engenn6le05ob02aud08"}], "type": "target_word"}, {"type": "takeaway_extension", "contents": [{"type": "text", "content": "Role-play a situation at a restaurant. Choose between the following roles:"}, {"type": "table", "content": "{\"rows\":1,\"columns\":2,\"cells\":[\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" You are a waiter or waitress. You make suggestions about the menu and reply politely to requests.\\\"}\",\"{\\\"type\\\": \\\"text\\\", \\\"content\\\": \\\" You are a difficult customer. You have questions and requests for the waiter or waitress. You eventually decide what to order.\\\"}\"],\"styles\":\"\"}"}, {"type": "text", "content": "Write a dialogue (12-14 lines) about the situation."}, {"type": "text", "content": "Read the dialogue aloud."}, {"type": "text", "content": "Change roles with your partner."}]}, {"type": "takeaway_assessment", "contents": [{"type": "text", "content": "I write a dialogue about dealing with difficult customers."}, {"type": "text", "content": "I offer suggestions and respond politely."}, {"type": "text", "content": "I express what is necessary and refuse politely."}, {"type": "text", "content": "I roleplay the dialogue in front of others.."}]}]}